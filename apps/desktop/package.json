{
  "name": "@computer/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Computer for Mac",
  "author": "Tim Cherny",
  "type": "commonjs",
  "main": "src/main.cjs",
  "scripts": {
    "package": "electron-builder --mac --dir",
    "package:share": "electron-builder --mac dmg zip --arm64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.computer.app",
    "productName": "Computer",
    "asar": true,
    "afterSign": "../../scripts/verify-mac-signature.cjs",
    "directories": { "output": "../../release" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "../web/dist", "to": "renderer", "filter": ["**/*"] }],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "strictVerify": true,
      "artifactName": "Computer-${version}-mac-${arch}.${ext}"
    },
    "dmg": { "title": "Computer ${version}", "sign": false }
  }
}
