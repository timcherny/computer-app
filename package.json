{
  "name": "computer-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "npm run dev --workspace @computer/web",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "storybook": "npm run storybook --workspace @computer/ui",
    "build:ui": "npm run build --workspace @computer/ui",
    "build": "npm run build:ui && npm run build --workspace @computer/web",
    "build:desktop": "npm run build && npm run package --workspace @computer/desktop",
    "build:share": "node scripts/build-share.mjs",
    "build:storybook": "npm run build-storybook --workspace @computer/ui",
    "deploy:web": "npm run build && node scripts/deploy-web.mjs",
    "preview": "npm run preview --workspace @computer/web"
  },
  "devDependencies": { "vite": "^8.3.4" }
}
