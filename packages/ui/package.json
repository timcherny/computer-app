{
  "name": "@computer/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Computer's reusable React components and theme tokens",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "development": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.js",
    "prepack": "npm run build",
    "storybook": "storybook dev --host 127.0.0.1 --port 6008 --exact-port --no-open --disable-telemetry",
    "build-storybook": "npm run build && storybook build --disable-telemetry"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.2",
    "vite": "^8.3.4"
  }
}
